{
    "name": "mharj-etag-tools",
    "version": "0.0.8",
    "description": "etag object tools",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
        },
        "default": "./dist/index.mjs"
    },
    "scripts": {
        "build": "tsdown src/index.ts --minify --sourcemap --format cjs,esm --dts --clean",
        "prepublishOnly": "npm run build",
        "test": "vitest test --run --no-isolate --coverage",
        "lint": "biome check",
        "validate": "tsc --noEmit --project tsconfig.test.json"
    },
    "repository": "github:mharj/mharj-etag-tools",
    "keywords": [
        "etag"
    ],
    "files": [
        "dist"
    ],
    "author": "mharj",
    "license": "LGPL-2.1-or-later",
    "bugs": {
        "url": "https://github.com/mharj/mharj-etag-tools/issues"
    },
    "homepage": "https://github.com/mharj/mharj-etag-tools#readme",
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@luolapeikko/result-option": "^2.4.0",
        "@types/node": "^24.13.5",
        "@vitest/coverage-v8": "^5.0.1",
        "c8": "^12.0.0",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "peerDependencies": {
        "@luolapeikko/result-option": ">= 1.0.0"
    },
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
